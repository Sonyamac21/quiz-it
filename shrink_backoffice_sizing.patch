+.qi-bo-venue-layout{display:grid;grid-template-columns:minmax(280px,.65fr) minmax(0,1.55fr);gap:18px;align-items:start}.qi-bo-venue-list{position:sticky;top:80px}.qi-bo-venue-list h2{margin:0 0 12px;font-size:20px}.qi-bo-venue-list>button{display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:10px;width:100%;min-height:64px;margin-bottom:8px;padding:10px;border:1px solid var(--qi-border);border-radius:12px;background:var(--qi-bg-surface);color:#fff;text-align:left;cursor:pointer}.qi-bo-venue-list>button[aria-pressed="true"]{border-color:var(--qi-accent-bright);background:var(--qi-bg-surface-elevated)}.qi-bo-venue-list strong,.qi-bo-venue-list small{display:block}.qi-bo-venue-list strong{font-size:14px}.qi-bo-venue-list small{margin-top:3px;color:var(--qi-text-secondary);font-size:12px}.qi-bo-venue-list i{color:var(--qi-text-secondary);font-size:11px;font-style:normal}.qi-bo-venue-logo{display:grid;place-items:center;width:48px;height:48px;overflow:hidden;border-radius:10px;background:var(--qi-bg-surface-elevated);font-size:14px;font-weight:900}.qi-bo-venue-logo img{width:100%;height:100%;object-fit:cover}.qi-bo-venue-profile{overflow:hidden;border:1px solid var(--qi-border);border-radius:16px;background:var(--qi-bg-surface);box-shadow:var(--qi-shadow-md)}.qi-bo-venue-profile>header,.qi-bo-venue-profile>footer{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:16px 20px}.qi-bo-venue-profile>header{border-bottom:1px solid var(--qi-border)}.qi-bo-venue-profile>header p{margin:0;color:var(--qi-accent-bright);font-size:12px;font-weight:800;text-transform:uppercase}.qi-bo-venue-profile>header h2{margin:4px 0 0;font-size:22px}.qi-bo-profile-tabs{display:flex;gap:4px;overflow-x:auto;padding:8px 20px;border-bottom:1px solid var(--qi-border)}.qi-bo-profile-tabs button{min-height:38px;padding:0 14px;border:0;border-radius:10px;background:transparent;color:var(--qi-text-secondary);font-size:13px;font-weight:800;text-transform:capitalize;cursor:pointer}.qi-bo-profile-tabs button[aria-pressed="true"]{background:var(--qi-bg-surface-elevated);color:#fff;box-shadow:inset 0 -3px var(--qi-accent)}.qi-bo-profile-section{padding:20px}.qi-bo-profile-section h3{margin:0;font-size:20px}.qi-bo-profile-section>p{margin:6px 0 18px;color:var(--qi-text-secondary);font-size:13px}.qi-bo-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 14px}.qi-bo-profile-section textarea{min-height:80px!important;font-size:14px!important;margin-bottom:14px}.qi-bo-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:10px 0 18px}.qi-bo-gallery>div{position:relative;aspect-ratio:4/3;overflow:hidden;border-radius:10px;background:var(--qi-bg-surface-elevated)}.qi-bo-gallery img{object-fit:cover}.qi-bo-gallery button{position:absolute;right:6px;top:6px;width:32px;height:32px;border:1px solid #fff;border-radius:50%;background:rgb(10 1 24/.82);color:#fff;font-size:16px}.qi-bo-active-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px;border:1px solid var(--qi-border);border-radius:12px}.qi-bo-active-row strong,.qi-bo-active-row span{display:block;font-size:13px}.qi-bo-active-row span{margin-top:3px;color:var(--qi-text-secondary)}.qi-bo-venue-profile>footer{border-top:1px solid var(--qi-border)}.qi-bo-venue-profile>footer>span{color:var(--qi-text-secondary);font-size:12px}
+.qi-bo-venue-list small,.qi-bo-venue-list i,.qi-bo-venue-profile>header p,.qi-bo-profile-tabs button,.qi-bo-venue-profile>footer>span{font-size:12px}
+.qi-bo-page-actions{display:flex;gap:10px}.qi-bo-calendar-tools{display:grid;grid-template-columns:auto auto minmax(380px,1fr);align-items:center;gap:12px;margin-bottom:16px;padding:14px;border:1px solid var(--qi-border);border-radius:14px;background:var(--qi-bg-surface)}.qi-bo-calendar-period,.qi-bo-calendar-views,.qi-bo-calendar-filters{display:flex;align-items:center;gap:8px}.qi-bo-calendar-period strong{min-width:140px;font-size:16px;text-align:center}.qi-bo-calendar-views button{text-transform:capitalize}.qi-bo-calendar-filters{justify-content:flex-end}.qi-bo-calendar-filters select{width:min(100%,190px)!important}.qi-bo-calendar-tools button,.qi-back-office main>section button{min-width:38px}.qi-bo-calendar-month{overflow-x:auto}
+.qi-bo-event-summary{display:grid;gap:8px;margin:12px 0}.qi-bo-event-summary>div{padding:11px 13px;border:1px solid var(--qi-border);border-radius:12px;background:var(--qi-bg-surface)}.qi-bo-event-summary span,.qi-bo-event-summary strong{display:block;font-size:13px}.qi-bo-event-summary span{color:var(--qi-text-secondary)}.qi-bo-event-summary strong{margin-top:3px}.qi-bo-event-options{margin:12px 0;padding:0 14px 14px;border:1px solid var(--qi-border);border-radius:12px;background:var(--qi-bg-surface)}.qi-bo-event-options summary{display:flex;align-items:center;min-height:44px;font-size:13px;font-weight:800;cursor:pointer}.qi-bo-event-options>p{margin:0 0 12px;color:var(--qi-text-secondary);font-size:13px}.qi-bo-event-options .fbh-lbl{margin-top:12px}
 .qi-live-prep-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;width:min(100%,720px);margin:0 auto 18px;text-align:left}.qi-live-prep-summary>div{padding:16px;border:1px solid var(--qi-border);border-radius:14px;background:var(--qi-bg-surface-elevated)}.qi-live-prep-summary span,.qi-live-prep-summary strong{display:block}.qi-live-prep-summary span{margin-bottom:5px;color:var(--qi-text-secondary);font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.qi-live-prep-summary strong{font-size:17px;line-height:1.3}
 .qi-bo-library-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:0 0 24px}.qi-bo-library-summary>div{display:flex;flex-direction:column;gap:5px;padding:22px 24px;border:1px solid #2E1A52;border-radius:18px;background:linear-gradient(145deg,rgba(26,13,54,.92),rgba(15,5,37,.88))}.qi-bo-library-summary strong{font-size:30px;line-height:1;color:#fff}.qi-bo-library-summary span{color:#B9A8D9;font-size:18px}.qi-bo-pagination{display:flex;align-items:center;justify-content:center;gap:18px;padding:18px 0 4px}.qi-bo-pagination span{min-width:130px;text-align:center;color:#B9A8D9;font-size:18px;font-weight:700}
 .qi-bo-setup-state{max-width:760px;padding:34px;border:1px solid #6B3A71;border-radius:22px;background:linear-gradient(145deg,rgba(52,20,67,.78),rgba(15,5,37,.94));box-shadow:var(--qi-shadow-md)}.qi-bo-setup-state>span{color:#F8B84E;font-size:18px;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.qi-bo-setup-state h2{margin:10px 0 8px;font-size:30px}.qi-bo-setup-state p{margin:0;color:var(--qi-text-secondary);font-size:18px;line-height:1.6}.qi-bo-setup-state details{margin-top:22px;padding-top:18px;border-top:1px solid var(--qi-border)}.qi-bo-setup-state summary{min-height:56px;font-size:18px;font-weight:800;cursor:pointer}.qi-bo-setup-state code{display:block;overflow-wrap:anywhere;color:#DCCEEF;font-size:16px;line-height:1.5}
